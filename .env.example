# ==========================================
# Meet Assistant - Production Environment Config
# ==========================================
# Copy this file to .env before deploying:
#   cp .env.example .env

# Web Server Port (Default: 80 for HTTP)
PORT=80

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=meeting_assistant

# ------------------------------------------
# Backend Application Security
# ------------------------------------------
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=generate_and_paste_a_secure_random_key_here
DEBUG=False
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------
# AI Service API Keys
# ------------------------------------------
# Groq Whisper (Fast transcription)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini (Summaries, action items, analytics, mindmaps)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# AssemblyAI (Speaker Diarization)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ------------------------------------------
# Transcription & Diarization Options
# ------------------------------------------
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_LANGUAGE=auto
ENABLE_TRANSCRIPT_CLEANUP=True
