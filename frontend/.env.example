# Meet Assistant Frontend Environment Variables

# Base URL for API requests.
# In local dev: http://localhost:8000/api/v1 (default if unset)
# In Docker/production with Nginx reverse proxy: leave empty or set to /api/v1
# If backend is on a separate domain (e.g. Render / Railway): https://api.yourdomain.com/api/v1
VITE_API_URL=

# WebSocket Base URL for Live Meeting captions and streaming.
# In local dev: defaults to ws://localhost:8000
# In Docker/production with Nginx: leave empty (it auto-detects ws:// or wss:// on window.location.host)
# If backend is on a separate domain: wss://api.yourdomain.com
VITE_WS_URL=
