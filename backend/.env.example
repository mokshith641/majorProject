# General Configurations
PROJECT_NAME="AI-Based Smart Meeting Assistant"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT Authentication
# You can generate a random secret key using: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# For SQLite local development: sqlite:///./sql_app.db
# For PostgreSQL/Supabase: postgresql://postgres.ref:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="sqlite:///./sql_app.db"

# Supabase Configurations (optional, if frontend/backend integration is needed)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Integration
GROQ_API_KEY="your-groq-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
ASSEMBLYAI_API_KEY="your-assemblyai-api-key-here"

# Speech-to-Text & Diarization Configurations
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo" # or whisper-large-v3
TRANSCRIPTION_LANGUAGE="en" # or auto for multilingual detection
MEETING_VOCABULARY_CONTEXT="Technical engineering meeting discussing authentication, authorization, login, Gmail, password, APIs, AI/ML, deployment, frontend, backend, database, PostgreSQL, SQLite, FastAPI, React, Python, Groq, Gemini, AssemblyAI, keystroke, mouse telemetry, meeting assistant."

# Local Whisper Fallback Configurations
WHISPER_MODEL_NAME="tiny.en"
WHISPER_DEVICE="cpu"

# Directory paths for storage
UPLOAD_DIR="./data/recordings"
REPORTS_DIR="./data/reports"
