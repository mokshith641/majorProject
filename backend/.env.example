# General Configurations
PROJECT_NAME="AI-Based Smart Meeting Assistant"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT Authentication
# You can generate a random secret key using: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# For SQLite local development: sqlite:///./sql_app.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/meeting_assistant
DATABASE_URL="sqlite:///./sql_app.db"

# AI Integration
GROQ_API_KEY="your-groq-api-key-here"

# Speech-to-Text Configurations
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_NAME="base"
# Options: cpu, cuda
WHISPER_DEVICE="cpu"

# Directory paths for storage
UPLOAD_DIR="./data/recordings"
REPORTS_DIR="./data/reports"
